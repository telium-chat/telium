{
  "name": "telium",
  "compatibility_date": "2026-09-26",
  // No main script, binding, or run_worker_first: all traffic is handled by
  // Workers Static Assets without invoking billed Worker JavaScript.
  // The files _redirects and _headers in dist-portal provide the SPA routing
  // and browser security policy, respectively.
  "workers_dev": false,
  "routes": [
    { "pattern": "telium.chat", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist-portal",
    // Keep the marketing homepage and 404 separate from the client shell.
    "not_found_handling": "404-page"
  }
}
