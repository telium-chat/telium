---
/* The lockup comes from the production logo kit. Both variants stay in the DOM
 * so the explicit site theme toggle can switch the wordmark without waiting
 * for the operating system's color-scheme preference. */
interface Props {
  size?: number
  class?: string
}
const { size = 36, class: className = '' } = Astro.props
const width = Math.round(size * 2.5)
---

<span class={`inline-flex items-center ${className}`}>
  <img
    src="/brand/telium-lockup-dark.svg"
    alt="Telium"
    width={width}
    height={size}
    class="telium-wordmark-dark block"
    style={`width:${width}px;height:${size}px`}
  />
  <img
    src="/brand/telium-lockup-light.svg"
    alt="Telium"
    width={width}
    height={size}
    class="telium-wordmark-light block"
    style={`width:${width}px;height:${size}px`}
  />
</span>
