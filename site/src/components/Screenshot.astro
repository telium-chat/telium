---
---

<section class="page shot-section pb-10 sm:pb-16">
  <figure class="reveal screenshot-stage">
    <div class="screenshot-frame relative overflow-hidden bg-surface">
      <img
        src="/screenshots/client-dark.webp"
        srcset="/screenshots/client-dark.webp 1x, /screenshots/client-dark@2x.webp 2x"
        width="1440"
        height="900"
        alt="The Telium client: a community rail on the left, a channel list, a conversation in #general, and a member list on the right."
        class="shot shot-dark block w-full"
        decoding="async"
        fetchpriority="high"
      />
      <img
        src="/screenshots/client-light.webp"
        srcset="/screenshots/client-light.webp 1x, /screenshots/client-light@2x.webp 2x"
        width="1440"
        height="900"
        alt=""
        aria-hidden="true"
        class="shot shot-light block w-full"
        decoding="async"
      />
    </div>
    <figcaption class="mt-5 text-center text-[14px] leading-relaxed text-muted">
      Telium with a community open: channels on the left, conversation in the middle, and members on the right.
    </figcaption>
  </figure>
</section>

<style>
  .shot-light { display: none; }
  :root[data-theme='light'] .shot-dark { display: none; }
  :root[data-theme='light'] .shot-light { display: block; }

  .shot-section {
    position: relative;
    z-index: 3;
    margin-top: -3rem;
  }

  .screenshot-stage {
    position: relative;
    isolation: isolate;
    perspective: 1600px;
    margin-inline: auto;
  }

  .screenshot-stage::before {
    content: '';
    position: absolute;
    z-index: -1;
    left: 8%;
    right: 8%;
    top: -12%;
    height: 34%;
    background: radial-gradient(
      ellipse at 50% 100%,
      color-mix(in oklab, var(--telium-violet) 22%, transparent),
      transparent 70%
    );
    pointer-events: none;
  }

  .screenshot-frame {
    border-radius: 20px;
    padding: 6px;
    background: var(--color-surface);
    border: 1px solid color-mix(in oklab, var(--color-foreground) 8%, transparent);
    box-shadow:
      inset 0 1px 0 color-mix(in oklab, var(--telium-lilac) 30%, transparent),
      0 40px 80px -40px rgb(0 0 0 / 0.7);
  }

  @supports (animation-timeline: view()) {
    .screenshot-frame {
      animation: shot-rise linear both;
      animation-timeline: view();
      animation-range: entry 0% cover 40%;
    }
  }

  @keyframes shot-rise {
    from {
      transform: rotateX(12deg) scale(0.96);
    }
    to {
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .screenshot-frame {
      animation: none;
    }
  }

  .screenshot-frame img {
    border-radius: 14px;
  }
</style>
