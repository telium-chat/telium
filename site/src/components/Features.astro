---
const features = [
  {
    title: 'A server you actually choose',
    body: "Join a public homeserver or run your own. Your first choice doesn't have to be permanent.",
  },
  {
    title: 'Move without starting over',
    body: 'Move your account to another homeserver later, instead of rebuilding your identity.',
  },
  {
    title: 'Private messages stay private',
    body: 'Direct messages and group DMs are end-to-end encrypted, with encrypted history recovery.',
  },
  {
    title: 'One account, many communities',
    body: 'Join communities on other Telium servers without signing up again for each one.',
  },
] as const
---

<section class="band" id="features">
  <div class="page">
    <div class="reveal grid gap-5 md:grid-cols-[minmax(0,.9fr)_minmax(0,1.1fr)] md:items-end">
      <div>
        <p class="eyebrow">Why Telium</p>
        <h2 class="h2 mt-3 max-w-[17ch]">Familiar chat. More control.</h2>
      </div>
      <p class="max-w-[55ch] text-[15px] leading-relaxed text-muted md:justify-self-end">
        You get the communities, calls and conversations you expect. You also get a say in
        where your account lives.
      </p>
    </div>

    <div class="feature-grid mt-12 grid gap-x-14 sm:grid-cols-2">
      {
        features.map((feature, index) => (
          <article class="feature-item reveal grid grid-cols-[2rem_minmax(0,1fr)] gap-4 py-7">
            <span class="feature-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <div>
              <h3 class="text-[18px] font-semibold leading-snug tracking-[-.02em]">{feature.title}</h3>
              <p class="mt-2 max-w-[47ch] text-[14px] leading-relaxed text-muted">{feature.body}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Editorial rows instead of a second set of UI tiles. The client screenshot
     above carries the visual weight; these explain the choices. */
  .feature-item { border-top: 1px solid var(--color-separator); }
  .feature-number {
    padding-top: 0.18rem;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-accent);
    font-variant-numeric: tabular-nums;
  }
</style>
