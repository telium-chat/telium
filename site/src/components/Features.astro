---
import Icon from './Icon.astro'

/* "How it works" already explains homeservers, federation and migration.
 * This section answers the separate question: what does the app feel like
 * to use every day? Keep features grounded in the shipped client. */
const features = [
  {
    icon: 'music',
    title: 'Music presence, built in',
    body: "Show friends what you're listening to from supported desktop media players. Your choice to share.",
    note: 'Desktop app',
  },
  {
    icon: 'device-gamepad-2',
    title: 'Game rich presence',
    body: "Let friends see what you're playing, with richer game details where supported.",
    note: 'Desktop app',
  },
  {
    icon: 'screen-share',
    title: 'Voice, video & screenshare',
    body: 'Hop into a call, share your screen and keep chatting without leaving your community.',
    note: 'Web & desktop',
  },
  {
    icon: 'lock',
    title: 'Private conversations',
    body: 'Direct messages and group DMs use end-to-end encryption, not just encryption in transit.',
    note: 'End-to-end encrypted',
  },
] as const
---

<section class="band" id="features">
  <div class="page">
    <div class="reveal grid gap-5 md:grid-cols-[minmax(0,.9fr)_minmax(0,1.1fr)] md:items-end">
      <div>
        <h2 class="h2 max-w-[18ch]">The good stuff comes standard.</h2>
      </div>
      <p class="max-w-[56ch] text-[16px] leading-relaxed text-muted md:justify-self-end">
        From what you're playing to who you're calling, Telium has the
        everyday features that make a chat app feel like home.
      </p>
    </div>

    <div class="feature-grid mt-12 grid gap-x-14 sm:grid-cols-2">
      {
        features.map((feature) => (
          <article class="feature-item reveal flex gap-4 py-7 sm:py-8">
            <span class="feature-icon mt-1 shrink-0" aria-hidden="true">
              <Icon name={feature.icon} size={21} />
            </span>
            <div class="min-w-0">
              <h3 class="text-[19px] font-semibold leading-snug tracking-[-.02em]">{feature.title}</h3>
              <p class="mt-2 max-w-[42ch] text-[15px] leading-relaxed text-muted">{feature.body}</p>
              <p class="feature-note mt-4">{feature.note}</p>
            </div>
          </article>
        ))
      }
    </div>

    <div class="no-plus reveal mt-6 grid gap-5 py-8 sm:mt-8 sm:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] sm:items-center sm:py-10">
      <div>
        <p class="no-plus-title">No Plus plan. Period.</p>
      </div>
      <p class="max-w-[48ch] text-[15px] leading-relaxed text-muted">
        Telium doesn't have a premium subscription or a separate tier of app features.
        No paywall to unlock the good stuff.
      </p>
    </div>
  </div>
</section>

<style>
  /* Four quiet editorial rows, not a second set of "how it works" cards.
     The icons are an accent to the actual features, not decorative art. */
  .feature-item {
    border-top: 1px solid var(--color-separator);
  }
  .feature-icon {
    display: grid;
    width: 2.5rem;
    height: 2.5rem;
    place-items: center;
    border-radius: 0.65rem;
    background: var(--color-accent-soft);
    color: var(--color-accent-soft-foreground);
  }
  .feature-note {
    color: var(--color-accent);
    font-size: 12.5px;
    font-weight: 500;
    letter-spacing: 0.01em;
  }
  /* The absence of a paid tier deserves a plainspoken sign-off, not a
     glowing purple sales card or an "exclusive" badge. */
  .no-plus {
    border-top: 1px solid var(--color-separator);
    border-bottom: 1px solid var(--color-separator);
  }
  .no-plus-title {
    font-size: clamp(1.7rem, 1.35rem + 1.25vw, 2.2rem);
    line-height: 1.2;
    font-weight: 600;
    letter-spacing: -0.025em;
    color: var(--color-foreground);
  }
</style>
