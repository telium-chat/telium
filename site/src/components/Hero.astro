---
import Icon from './Icon.astro'
import AsciiOrbit from './AsciiOrbit.astro'
import { URLS } from '../config'
---

<section class="hero">
  <div class="hero-glow" aria-hidden="true"></div>
  <AsciiOrbit />
  <div class="hero-scrim" aria-hidden="true"></div>

  <div class="hero-text">
    <h1 class="hero-headline rise-in">
      <span class="block">Choose your server.</span>
      <span class="block hero-headline-lilac">Keep your people.</span>
    </h1>
    <p class="rise-in mx-auto mt-6 max-w-[46ch] text-center text-[18px] leading-[1.6] text-muted" style="animation-delay: 70ms">
      Community chat, voice, video and encrypted private messages on a server you choose.
      Join communities across servers, and take your account with you if you move.
    </p>
    <div class="rise-in mt-9 flex flex-wrap items-center justify-center gap-3" style="animation-delay: 120ms">
      <a href={URLS.client} class="btn-pill btn-pill-primary">
        Open Telium
        <Icon name="arrow-right" size={17} />
      </a>
      <a href={URLS.download} class="btn-pill btn-pill-secondary">Download the app</a>
    </div>
    <p class="hero-facts rise-in mt-8 text-center text-[13px] text-muted" style="animation-delay: 170ms">
      Open source <span aria-hidden="true">·</span> Self-hostable <span aria-hidden="true">·</span> Federated
    </p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    margin-top: calc(-1 * var(--header-h));
    min-height: max(640px, 100svh);
    display: grid;
    align-content: end;
    justify-items: center;
    padding-top: var(--header-h);
    padding-bottom: clamp(4rem, 10vh, 7rem);
    padding-inline: 1.5rem;
  }

  .hero-glow {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(
        ellipse 42% 34% at 50% 40%,
        color-mix(in oklab, var(--telium-violet) 32%, transparent),
        transparent 60%
      ),
      radial-gradient(
        ellipse 75% 60% at 50% 40%,
        color-mix(in oklab, var(--telium-violet) 9%, transparent),
        transparent 65%
      ),
      linear-gradient(
        to bottom,
        transparent 75%,
        var(--color-background)
      );
  }

  .hero-scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: radial-gradient(
      ellipse 52% 30% at 50% 78%,
      color-mix(in oklab, var(--color-background) 80%, transparent),
      transparent 65%
    );
  }

  .hero-text {
    position: relative;
    z-index: 2;
    max-width: 980px;
    text-align: center;
  }

  .hero-headline {
    font-weight: 300;
    font-size: clamp(2.15rem, 1.1rem + 4.9vw, 6rem);
    line-height: 1.02;
    letter-spacing: -0.04em;
    color: var(--color-foreground);
    text-wrap: balance;
  }

  .hero-headline-lilac {
    color: oklch(86% 0.06 300);
  }

  .hero-facts span {
    margin-inline: 0.6rem;
    color: var(--color-accent);
  }

  @media (max-width: 640px) {
    .hero-facts span {
      margin-inline: 0.3rem;
    }
  }
</style>
