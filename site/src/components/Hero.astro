---
import Icon from './Icon.astro'
import { URLS } from '../config'
---

<section class="hero page relative isolate overflow-hidden pt-20 pb-20 sm:pt-28 sm:pb-28 lg:pt-32 lg:pb-36">
  <div class="hero-mark-wrap" aria-hidden="true">
    <img src="/brand/telium-mark-gradient.svg" alt="" width="700" height="700" class="hero-mark" decoding="async" />
  </div>
  <div class="relative z-10 max-w-[900px]">
    <h1 class="display rise-in max-w-[18ch]">
      <span class="block">Choose your server.</span>
      <span class="block text-accent">Keep your people.</span>
    </h1>
    <p class="lead rise-in mt-7 max-w-[52ch]" style="animation-delay: 70ms">
      Community chat, voice, video and encrypted private messages on a server you choose.
      Join communities across servers, and take your account with you if you move.
    </p>
    <div class="rise-in mt-9 flex flex-wrap items-center gap-3" style="animation-delay: 120ms">
      <a href={URLS.client} class="btn btn-primary btn-lg">
        Open Telium
        <Icon name="arrow-right" size={17} />
      </a>
      <a href={URLS.download} class="btn btn-secondary btn-lg">Download the app</a>
    </div>
    <p class="hero-facts rise-in mt-8 text-[13px] text-muted" style="animation-delay: 170ms">
      Open source <span aria-hidden="true">·</span> Self-hostable <span aria-hidden="true">·</span> Federated
    </p>
  </div>
</section>

<style>
  /* Let the mark itself be the hero illustration, without invented UI chrome. */
  .hero-mark-wrap {
    position: absolute;
    z-index: 0;
    /* Keep the entire orbit inside the hero's painted bounds. Previously it
       was deliberately shoved ~20rem to the right and clipped by the section. */
    width: clamp(21rem, 40vw, 31rem);
    aspect-ratio: 1;
    right: max(2rem, 4vw);
    top: 50%;
    transform: translateY(-50%) rotate(-9deg);
    pointer-events: none;
    opacity: 0.19;
    filter: saturate(0.85);
  }
  .hero-mark { display: block; width: 100%; height: 100%; }
  :root[data-theme='light'] .hero-mark-wrap { opacity: 0.095; }
  .hero-facts span { margin-inline: 0.6rem; color: var(--color-accent); }
  @media (max-width: 900px) {
    .hero-mark-wrap { width: min(42vw, 22rem); right: 1.5rem; opacity: 0.12; }
    :root[data-theme='light'] .hero-mark-wrap { opacity: 0.07; }
  }
  @media (max-width: 640px) {
    /* Small screens use a quieter watermark behind the content, never a
       cropped ring protruding off the right edge. */
    .hero-mark-wrap { width: min(75vw, 21rem); right: 1rem; top: 61%; opacity: 0.065; }
    :root[data-theme='light'] .hero-mark-wrap { opacity: 0.045; }
    .hero-facts span { margin-inline: 0.3rem; }
  }
</style>
