---
import { loadIcon } from '../lib/icon'

interface Props {
  name: string
  size?: number
  strokeWidth?: number
  class?: string
}

const { name, size = 18, strokeWidth = 1.75, class: className = '' } = Astro.props
const inner = loadIcon(name)
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  class={className}
  set:html={inner}
/>
