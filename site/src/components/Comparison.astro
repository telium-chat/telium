---
const products = [
  { key: 'telium', name: 'Telium', note: 'community chat + movable homeservers', telium: true },
  { key: 'discord', name: 'Discord', note: 'centralized community platform', telium: false },
  { key: 'matrix', name: 'Matrix / Element', note: 'federated protocol + client', telium: false },
  { key: 'stoat', name: 'Stoat', note: 'formerly Revolt', telium: false },
  { key: 'fluxer', name: 'Fluxer', note: 'open-source community chat', telium: false },
] as const

type State = 'yes' | 'no' | 'partial' | 'neutral'
type Value = { state: State; label: string; detail?: string }

const rows: {
  label: string
  hint: string
  values: Record<(typeof products)[number]['key'], Value>
}[] = [
  {
    label: 'Open source',
    hint: 'Can the core chat stack be inspected and forked?',
    values: {
      telium: { state: 'yes', label: 'Yes', detail: 'Apache-2.0' },
      discord: { state: 'no', label: 'No', detail: 'Proprietary service' },
      matrix: { state: 'yes', label: 'Yes', detail: 'Open protocol and implementations' },
      stoat: { state: 'yes', label: 'Yes', detail: 'Open-source stack' },
      fluxer: { state: 'yes', label: 'Yes', detail: 'AGPL-3.0' },
    },
  },
  {
    label: 'Self-host a server',
    hint: 'Can you run the service on infrastructure you control?',
    values: {
      telium: { state: 'yes', label: 'Yes', detail: 'Single Telium server program' },
      discord: { state: 'no', label: 'No', detail: 'Discord operates the network' },
      matrix: { state: 'yes', label: 'Yes', detail: 'Many homeserver choices' },
      stoat: { state: 'yes', label: 'Yes', detail: 'Web/PWA works best for self-hosting today' },
      fluxer: { state: 'yes', label: 'Yes', detail: 'Docker-based self-hosting' },
    },
  },
  {
    label: 'Independent servers interoperate',
    hint: 'Can separately operated servers participate in the same network?',
    values: {
      telium: { state: 'yes', label: 'Yes', detail: 'Accounts can join communities on other servers' },
      discord: { state: 'no', label: 'No', detail: 'One centrally operated network' },
      matrix: { state: 'yes', label: 'Yes', detail: 'Full homeserver federation' },
      stoat: { state: 'no', label: 'No', detail: 'Stoat says federation is not currently supported' },
      fluxer: { state: 'partial', label: 'Not today', detail: 'Self-hosting exists; federation is not a current feature' },
    },
  },
  {
    label: 'Move your account to another provider',
    hint: 'Can your identity move without simply starting a second account?',
    values: {
      telium: { state: 'yes', label: 'Built in', detail: 'Account migration is part of the protocol' },
      discord: { state: 'neutral', label: 'Not applicable', detail: 'There are no independent Discord providers' },
      matrix: { state: 'partial', label: 'Not generally', detail: 'Portable identity remains an unsolved everyday path' },
      stoat: { state: 'no', label: 'No general path', detail: 'Self-hosted instances are separate' },
      fluxer: { state: 'no', label: 'No general path', detail: 'Independent instances do not interoperate today' },
    },
  },
  {
    label: 'End-to-end encrypted private text',
    hint: 'Are private text conversations unreadable to the service carrying them?',
    values: {
      telium: { state: 'yes', label: 'Yes', detail: 'Direct messages and group DMs' },
      discord: { state: 'no', label: 'No', detail: 'Discord explicitly keeps text outside E2EE' },
      matrix: { state: 'yes', label: 'Yes', detail: 'Element supports E2EE rooms and DMs' },
      stoat: { state: 'neutral', label: 'Not advertised', detail: 'Current public material does not claim text E2EE' },
      fluxer: { state: 'no', label: 'Not yet', detail: 'Fluxer says DM E2EE is planned' },
    },
  },
  {
    label: 'Voice, video and screenshare',
    hint: 'Can a community handle live conversation without leaving the product?',
    values: {
      telium: { state: 'yes', label: 'Yes', detail: 'Built in' },
      discord: { state: 'yes', label: 'Yes', detail: 'Built in; calls use E2EE' },
      matrix: { state: 'yes', label: 'Yes', detail: 'Element supports calls and screen sharing' },
      stoat: { state: 'yes', label: 'Yes', detail: 'Video and screen share shipped July 2026' },
      fluxer: { state: 'yes', label: 'Yes', detail: 'Built in' },
    },
  },
]

const sources = [
  { label: 'Discord', href: 'https://discord.com/blog/every-voice-and-video-call-on-discord-is-now-end-to-end-encrypted' },
  { label: 'Matrix', href: 'https://matrix.org/foundation/about/' },
  { label: 'Element', href: 'https://www.matrix.org/ecosystem/clients/element/' },
  { label: 'Matrix portability', href: 'https://matrix.org/blog/2024/03/why-matrix-org/' },
  { label: 'Stoat', href: 'https://developers.stoat.chat/faq/' },
  { label: 'Fluxer self-hosting', href: 'https://docs.fluxer.app/operator/get-started/' },
  { label: 'Fluxer privacy', href: 'https://fluxer.app/privacy' },
] as const
---

<section class="band" id="compare">
  <div class="page">
    <div class="reveal grid gap-5 md:grid-cols-[minmax(0,.8fr)_minmax(0,1.2fr)] md:items-end">
      <div>
        <p class="eyebrow">Compare</p>
        <h2 class="h2 comparison-title mt-3 max-w-[18ch]">See what stays in your hands.</h2>
      </div>
      <p class="max-w-[60ch] text-[16px] leading-relaxed text-muted md:justify-self-end">
        A familiar set of chat features, with a different approach to server choice,
        cross-server communities and account portability.
      </p>
    </div>

    <div class="comparison-shell reveal mt-10">
      <p class="comparison-cue mb-4 text-[13px] text-muted sm:hidden">
        Swipe sideways to compare more services <span aria-hidden="true">→</span>
      </p>
      <div
        class="comparison-scroll overflow-x-auto"
        role="region"
        aria-label="Feature comparison; scroll horizontally to see more services"
        tabindex="0"
      >
        <table class="comparison-table w-full table-fixed">
          <caption class="sr-only">
            Telium compared with Discord, Matrix and Element, Stoat, and Fluxer.
            Detailed explanations are provided in the cell labels and tooltips.
          </caption>
          <colgroup>
            <col class="feature-col" />
            {products.map(() => <col />)}
          </colgroup>
          <thead>
            <tr>
              <th scope="col" class="feature-label feature-heading">Feature</th>
              {
                products.map((product) => (
                  <th
                    scope="col"
                    class:list={[
                      'product-heading',
                      product.telium && 'telium-column',
                    ]}
                  >
                    {product.name}
                  </th>
                ))
              }
            </tr>
          </thead>
          <tbody>
            {
              rows.map((row) => (
                <tr>
                  <th scope="row" class="feature-label" title={row.hint}>
                    <span>{row.label}</span>
                  </th>
                  {
                    products.map((product) => {
                      const value = row.values[product.key]
                      return (
                        <td
                          class:list={['status-cell', product.telium && 'telium-column']}
                          title={value.detail ? `${value.label} — ${value.detail}` : value.label}
                        >
                          <span class:list={['status-glyph', `status-${value.state}`]} aria-hidden="true">
                            {value.state === 'yes' ? '✓' : value.state === 'neutral' ? '·' : ''}
                          </span>
                          {(value.state === 'partial' || value.state === 'neutral' || (product.telium && value.label !== 'Yes')) && (
                            <span class="status-caption">{value.label}</span>
                          )}
                          <span class="sr-only">
                            {`${product.name}: ${value.label}. ${value.detail ?? ''}`}
                          </span>
                        </td>
                      )
                    })
                  }
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <div class="comparison-footer mt-7 space-y-5 text-[13px] text-muted">
        <div class="comparison-legend flex flex-wrap items-center gap-x-6 gap-y-3" aria-label="Comparison key">
          <span><i class="status-glyph status-yes" aria-hidden="true">✓</i> Yes</span>
          <span><i class="status-glyph status-partial" aria-hidden="true"></i> Limited</span>
          <span><i class="status-glyph status-no" aria-hidden="true"></i> No</span>
          <span><i class="status-glyph status-neutral" aria-hidden="true">·</i> Not comparable / unconfirmed</span>
        </div>
        <div class="comparison-sources max-w-[90ch] leading-relaxed">
          <span>Public documentation reviewed August 2026. </span>
          <span>Sources: </span>
          {
            sources.map((source, index) => (
              <>
                {index > 0 && <span aria-hidden="true"> · </span>}
                <a href={source.href} rel="noreferrer" class="text-link underline-offset-2 hover:underline">{source.label}</a>
              </>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* The docs graphic is a visual reference, not an embedded asset. Every
     feature and result remains selectable, themeable and accessible HTML. */
  .comparison-table {
    min-width: 970px;
    border-collapse: separate;
    border-spacing: 0;
    text-align: center;
  }

  .comparison-table .feature-col { width: 248px; }

  .comparison-table th,
  .comparison-table td {
    padding: 1.42rem 0.85rem;
    vertical-align: middle;
  }

  .comparison-table .feature-label {
    position: sticky;
    left: 0;
    z-index: 2;
    width: 248px;
    padding-inline: 1.2rem;
    text-align: left;
    font-size: 15px;
    line-height: 1.4;
    font-weight: 500;
    background: var(--color-background);
    box-shadow: 1px 0 0 var(--color-separator);
  }

  .comparison-table .feature-heading {
    z-index: 3;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.07em;
  }

  .comparison-table .product-heading {
    padding-block: 1.65rem;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.3;
    white-space: normal;
  }

  /* Alternating horizontal bands are easier to trace than a box around
     every cell. Keep the frozen feature label opaque when the table scrolls. */
  .comparison-table tbody tr:nth-child(odd) > :not(.telium-column) {
    background: var(--color-surface);
  }
  .comparison-table tbody tr:nth-child(odd) > .feature-label {
    border-radius: var(--radius-row) 0 0 var(--radius-row);
  }
  .comparison-table tbody tr:nth-child(odd) > :last-child:not(.telium-column) {
    border-radius: 0 var(--radius-row) var(--radius-row) 0;
  }

  /* The sticky feature label paints over the edge of the adjacent column.
     Draw the Telium rails *inside* its cells so the left rail can't vanish
     behind that sticky label when the comparison scrolls. */
  .comparison-table .telium-column {
    background: color-mix(in oklab, var(--color-accent-soft) 66%, var(--color-surface));
    box-shadow:
      inset 2px 0 0 var(--color-accent),
      inset -1px 0 0 var(--color-accent);
  }
  .comparison-table .product-heading.telium-column {
    border-top: 1px solid var(--color-accent);
    border-radius: 12px 12px 0 0;
    color: var(--color-accent-soft-foreground);
  }
  .comparison-table tbody tr:last-child > .telium-column {
    border-bottom: 1px solid var(--color-accent);
    border-radius: 0 0 12px 12px;
  }

  .status-cell { text-align: center; }
  .status-glyph {
    display: inline-flex;
    width: 28px;
    height: 28px;
    flex: none;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    font-family: var(--font-sans);
    font-size: 18px;
    font-weight: 650;
    line-height: 1;
    font-style: normal;
    vertical-align: middle;
  }
  .status-yes {
    background: var(--color-accent-solid);
    color: var(--color-accent-solid-foreground);
  }
  .status-no {
    border: 1.5px solid var(--color-muted);
    opacity: 0.85;
  }
  .status-partial {
    border: 1.5px solid var(--color-warning);
    color: var(--color-warning);
  }
  /* Glyph baselines differ by font and size. A geometric stroke stays
     precisely centered in both the 28px table icons and 19px legend icons. */
  .status-partial::before {
    content: '';
    display: block;
    width: 11px;
    height: 2px;
    border-radius: 1px;
    background: currentColor;
  }
  .status-neutral {
    border: 1.5px solid var(--color-muted);
    color: var(--color-muted);
    font-size: 19px;
    opacity: 0.85;
  }
  .status-caption {
    display: block;
    max-width: 132px;
    margin: 0.4rem auto 0;
    color: var(--color-muted);
    font-size: 12px;
    line-height: 1.35;
  }
  .comparison-legend > span {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    white-space: nowrap;
  }
  .comparison-legend .status-glyph {
    width: 19px;
    height: 19px;
    font-size: 12px;
  }
  .comparison-legend .status-partial::before { width: 8px; height: 2px; }
  .comparison-legend .status-neutral { font-size: 14px; }

  .comparison-title {
    font-size: clamp(2.3rem, 1.6rem + 2.3vw, 2.85rem);
    line-height: 1.12;
  }

  @media (max-width: 640px) {
    .comparison-scroll {
      margin-inline: -0.5rem;
      scrollbar-width: thin;
    }
    .comparison-table { min-width: 900px; }
    .comparison-table .feature-col,
    .comparison-table .feature-label { width: 188px; }
    .comparison-table .feature-label { padding-inline: 0.8rem; font-size: 14px; }
    .comparison-table .product-heading { font-size: 15px; }
    .comparison-table th,
    .comparison-table td { padding-block: 1.25rem; }
    .status-caption { font-size: 11.5px; }
  }
</style>
