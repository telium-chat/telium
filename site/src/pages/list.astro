---
import Base from '../layouts/Base.astro'
import Icon from '../components/Icon.astro'
import { URLS } from '../config'
import { SIZE_LABEL, BAND_LABEL } from '../lib/registry-format'

/* The listing wizard. The directory's own rule has always been that a machine
   verifies what a machine can verify, and an operator declares the rest. The
   tables render that split; this page is the operator's half of it: it probes
   the same endpoints the hourly probe uses — from the visitor's browser, so
   there are no surprises when CI repeats the check — asks only for the facts
   the probe cannot determine, and files the prefilled listing issue the
   automation turns into a pull request. Nothing here writes to the registry;
   the git history stays the record, and a person still merges. */
const sizeOptions = Object.entries(SIZE_LABEL)
const bandOptions = Object.entries(BAND_LABEL)
const regionCodes = [
  'af-south', 'ap-east', 'ap-south', 'ap-southeast', 'eu-central', 'eu-north',
  'eu-west', 'me-central', 'na-central', 'na-east', 'na-west', 'oc-southeast', 'sa-east',
]
---

<Base
  title="List your server"
  description="Add your homeserver or relay to the Telium directories. The wizard checks your server live, builds the registry entry, and files the listing request for you."
>
  <section class="page pt-14 pb-10 sm:pt-20">
    <p class="eyebrow">Directory</p>
    <h1 class="h2 mt-3 max-w-[20ch]">List your server.</h1>
  </section>

  <section class="page pb-16">
    <div class="wizard" data-wizard>
      {/* --- what are you listing ------------------------------------------------ */}
      <div class="panel p-5 sm:p-6">
        <p class="eyebrow">What are you listing?</p>
        <div class="mt-3 flex flex-wrap gap-2">
          <button type="button" class="mode-btn" data-mode-switch="server" aria-pressed="true">
            A homeserver
          </button>
          <button type="button" class="mode-btn" data-mode-switch="sfu" aria-pressed="false">
            A relay (SFU)
          </button>
        </div>
      </div>

      {/* --- step 1: check ------------------------------------------------------- */}
      <div class="panel mt-5 p-5 sm:p-6">
        <p class="eyebrow">Step 1 · Check it</p>
        <p class="mt-2 max-w-[60ch] text-[13.5px] leading-relaxed text-muted">
          Checks your server from the browser, using its two public endpoints. Nothing is
          submitted until step 3. Not set up for the public directory yet? The{' '}
          <a href={URLS.onboardingSpec} class="rounded text-link hover:underline">onboarding guide</a>
          {' '}covers the small changes that make a server listable.
        </p>
        <div class="mt-4 flex flex-col gap-2 sm:flex-row">
          <label class="relative flex-1">
            <span class="sr-only" data-check-label>Server domain</span>
            <input
              type="text"
              data-check-input
              placeholder="chat.example.org"
              autocomplete="off"
              spellcheck="false"
              disabled
              class="field w-full px-3 py-2.5 font-mono text-[13.5px] placeholder:text-muted"
            />
          </label>
          <button type="button" class="btn btn-primary" data-check-button disabled>
            Check
          </button>
        </div>
        <ul class="mt-4 space-y-1.5" data-gates aria-live="polite"></ul>
        <button type="button" class="btn btn-secondary mt-4" data-continue disabled>
          Continue
        </button>
      </div>

      {/* --- step 2: describe ---------------------------------------------------- */}
      <div class="panel mt-5 p-5 sm:p-6" data-stage-details hidden>
        <p class="eyebrow">Step 2 · Describe it</p>
        <p class="mt-2 max-w-[60ch] text-[13.5px] leading-relaxed text-muted">
          The details the directory can't find out by itself. Everything else on your row
          updates on its own from the hourly checks.
        </p>

        <div class="mt-4 grid gap-4 sm:grid-cols-2">
          <label class="field-label">
            <span data-field-name-label>Server name</span>
            <input type="text" data-field-name maxlength="40" autocomplete="off" class="field mt-1.5 w-full px-3 py-2.5 text-[13.5px]" />
          </label>

          <label class="field-label">
            <span>Operator</span>
            <input type="text" data-field-operator maxlength="60" autocomplete="off" placeholder="Who runs it" class="field mt-1.5 w-full px-3 py-2.5 text-[13.5px]" />
          </label>

          <label class="field-label sm:col-span-2">
            <span>One sentence — who runs it and who it's for</span>
            <textarea data-field-description maxlength="160" rows="2" class="field mt-1.5 w-full resize-none px-3 py-2.5 text-[13.5px]"></textarea>
            <span class="tnum mt-1 block text-right text-[12px] text-muted"><span data-desc-count>0</span>/160</span>
          </label>

          <label class="field-label">
            <span>Where the hardware is</span>
            <input type="text" data-field-region-label maxlength="40" autocomplete="off" placeholder="Frankfurt, DE" class="field mt-1.5 w-full px-3 py-2.5 text-[13.5px]" />
          </label>

          <label class="field-label">
            <span>Region code</span>
            <select data-field-region-code class="field mt-1.5 w-full px-3 py-2.5 text-[13.5px]">
              <option value="">Choose the nearest</option>
              {regionCodes.map((code) => <option value={code}>{code}</option>)}
            </select>
          </label>

          <label class="field-label" data-band-server>
            <span>Roughly how many accounts</span>
            <select data-field-size class="field mt-1.5 w-full px-3 py-2.5 text-[13.5px]">
              <option value="">Self-declared range</option>
              {sizeOptions.map(([value, label]) => <option value={value}>{label}</option>)}
            </select>
          </label>

          <label class="field-label" data-band-sfu hidden>
            <span>Uplink capacity</span>
            <select data-field-capacity class="field mt-1.5 w-full px-3 py-2.5 text-[13.5px]">
              <option value="">Self-declared band</option>
              {bandOptions.map(([value, label]) => <option value={value}>{label}</option>)}
            </select>
          </label>

          <label class="field-label sm:col-span-2">
            <span>Contact a person actually reads</span>
            <input type="text" data-field-contact maxlength="200" autocomplete="off" placeholder="https://example.org/contact or mailto:ops@example.org" class="field mt-1.5 w-full px-3 py-2.5 font-mono text-[13.5px]" />
          </label>
        </div>

        <label class="mt-4 flex cursor-pointer items-start gap-2.5 text-[13.5px] leading-relaxed select-none">
          <input type="checkbox" data-field-consent class="mt-0.5 size-3.5 accent-[var(--color-accent)]" />
          <span data-consent-label>
            Also suggest this server automatically to people picking their first server.
            Optional — your listing stays either way.
          </span>
        </label>

        {/* The row preview mirrors ServerTable.astro's markup — the build-time
            component cannot take runtime data, and scoped styles do not cross
            files, so the few rules the preview needs are repeated below. */}
        <div class="panel-inset mt-5 px-4 py-3" data-preview hidden>
          <p class="eyebrow mb-2">Your row, as it will read</p>
          <table class="w-full border-collapse text-left">
            <tbody>
              <tr class="body-row align-middle">
                <td class="py-3 pr-4">
                  <div class="flex items-center gap-2">
                    <span class="font-medium" data-preview-name>—</span>
                    <span class="preview-badge" data-preview-badge hidden></span>
                  </div>
                  <div class="mt-0.5 font-mono text-[12.5px] text-muted" data-preview-domain>—</div>
                </td>
                <td class="hidden py-3 pr-4 text-[13.5px] text-muted sm:table-cell" data-preview-region>—</td>
                <td class="tnum hidden py-3 text-right text-[13.5px] text-muted md:table-cell" data-preview-band>—</td>
                <td class="tnum py-3 text-right text-[13.5px] text-muted" title="Uptime starts at the first hourly probe after the merge">—</td>
              </tr>
            </tbody>
          </table>
          <p class="mt-3 max-w-[62ch] text-[13px] leading-relaxed text-muted" data-preview-description></p>
          <dl class="mt-2 grid grid-cols-[auto_1fr] gap-x-5 gap-y-1.5 text-[13px]">
            <dt class="text-muted">Operator</dt>
            <dd data-preview-operator>—</dd>
            <dt class="text-muted">Version</dt>
            <dd class="font-mono" data-preview-version>—</dd>
          </dl>
        </div>
      </div>

      {/* --- step 3: file the request --------------------------------------------- */}
      <div class="panel mt-5 p-5 sm:p-6" data-stage-submit hidden>
        <p class="eyebrow">Step 3 · File the request</p>
        <p class="mt-2 max-w-[60ch] text-[13.5px] leading-relaxed text-muted">
          Open it on GitHub and press <em>Create</em>. Automation files the pull request,
          CI checks your server again from there, and a maintainer merges. The listing goes
          up at the next site build.
        </p>

        <ul class="mt-4 space-y-1.5 text-[13px]" data-preflight aria-live="polite"></ul>

        <div class="mt-4 flex flex-wrap items-center gap-3">
          <a class="btn btn-primary" data-github-button href="#" target="_blank" rel="noreferrer" aria-disabled="true">
            Open the listing request on GitHub
          </a>
          <button type="button" class="btn btn-secondary" data-copy-button>Copy the entry</button>
        </div>
        <p class="mt-2 text-[12.5px] text-muted">
          If GitHub opens the form empty, paste the block below into the <em>Registry
          entry</em> field. The checkboxes are yours to tick.
        </p>

        <pre class="mt-4 overflow-x-auto p-4 text-[12px] leading-relaxed" data-json-block><code data-json></code></pre>
      </div>
    </div>

    {/* The path that always works, with or without JavaScript: the registry is
        a file in a public repository, and editing it needs nothing this page
        has. Kept visible rather than noscript-only, because "do it by hand"
        is a preference, not a fallback condition. */}
    <details class="disclosure mt-8 py-4 text-[13px] leading-relaxed text-muted">
      <summary class="disclosure-summary">
        <Icon name="chevron-down" size={15} />
        Prefer to do it by hand?
      </summary>
      <div class="prose-measure mt-3 space-y-2">
        <p>
          Fork the repository, add your entry to <span class="font-mono">site/registry/servers.json</span>
          {' '}(or <span class="font-mono">site/registry/sfus.json</span> for a relay), keeping the file sorted,
          and open a pull request. The README documents every field, and the validators run on your
          pull request and speak in plain language.
        </p>
        <p>
          <a href={URLS.registry} class="rounded text-link hover:underline">
            The registry and its rules
            <Icon name="arrow-up-right" size={14} />
          </a>
        </p>
      </div>
    </details>
  </section>
</Base>

<style>
  .panel {
    border-radius: var(--radius-card);
    background: var(--color-surface);
    box-shadow: inset 0 0 0 1px var(--color-separator);
  }

  /* A mode switch is two buttons where exactly one is pressed; aria-pressed
     carries the state, the fill carries it visually. */
  .mode-btn {
    border-radius: var(--radius-row);
    padding: 0.375rem 0.875rem;
    font-size: 13.5px;
    background: var(--color-surface-secondary);
    color: var(--color-muted);
    cursor: pointer;
  }
  .mode-btn[aria-pressed='true'] {
    background: var(--color-accent-soft);
    color: var(--color-accent-soft-foreground);
    font-weight: 500;
  }

  /* Filled and edgeless, the shape every input in the client wears. */
  .field {
    border: 0;
    border-radius: var(--radius-row);
    background: var(--color-surface-secondary);
    color: var(--color-foreground);
  }
  .field-label {
    display: block;
    font-size: 13px;
    color: var(--color-muted);
  }
  .field-label > span:first-child {
    font-weight: 500;
    color: var(--color-foreground);
  }

  /* Gate states are dots before text: pass, warn, fail. A missing check has
     no dot at all, so the list starts empty rather than all-grey. */
  [data-gates] li {
    display: flex;
    align-items: baseline;
    gap: 0.625rem;
    font-size: 13.5px;
    color: var(--color-muted);
  }
  [data-gates] li::before {
    content: '';
    flex: none;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    transform: translateY(-1px);
    background: var(--color-surface-secondary);
    box-shadow: inset 0 0 0 1px var(--color-separator);
  }
  [data-gates] li[data-state='pass']::before {
    background: var(--color-accent);
  }
  [data-gates] li[data-state='warn']::before {
    background: var(--color-warning);
  }
  [data-gates] li[data-state='fail']::before {
    background: var(--color-danger);
  }
  [data-gates] li[data-state='pass'] {
    color: var(--color-foreground);
  }

  /* The preview's badges mirror ServerTable.astro's — scoped styles do not
     cross files, and every badge is a fill. */
  .preview-badge {
    display: inline-block;
    border-radius: 4px;
    padding: 0.0625rem 0.3125rem;
    font-size: 11px;
    font-weight: 500;
    line-height: 1.45;
  }
  .preview-badge[data-badge='open'],
  .preview-badge[data-badge='healthy'] {
    background: var(--color-accent-soft);
    color: var(--color-accent-soft-foreground);
  }
  .preview-badge[data-badge='closed'] {
    background: color-mix(in oklab, var(--color-foreground) 9%, transparent);
    color: var(--color-muted);
  }
  .preview-badge[data-badge='down'],
  .preview-badge[data-badge='full'] {
    background: var(--color-danger-soft);
    color: var(--color-danger-soft-foreground);
  }

  .body-row {
    border-bottom: 1px solid var(--color-separator);
  }

  .disclosure {
    border-top: 1px solid var(--color-separator);
  }
  .disclosure-summary {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
    list-style: none;
    color: var(--color-foreground);
    font-weight: 500;
  }
  .disclosure-summary::-webkit-details-marker {
    display: none;
  }
  .disclosure-summary :global(svg) {
    flex: none;
    color: var(--color-muted);
    transition: transform var(--dur-2) var(--ease);
  }
  .disclosure[open] .disclosure-summary :global(svg) {
    transform: rotate(180deg);
  }

  [data-json-block] {
    border-radius: var(--radius-row);
    background: var(--color-surface-secondary);
    font-family: var(--font-mono);
    white-space: pre;
  }
</style>

<script>
  /* Progressive enhancement, the same discipline as ServerTable: the page
     above is complete without JavaScript — the checks read as instructions,
     the manual path is open — and this script turns it into the wizard. */

  type Mode = 'server' | 'sfu'

  const TIMEOUT_MS = 8000

  // The validators' own rules, mirrored for pre-flight feedback so the first
  // round-trip a mistake costs is the issue, not a failed CI run.
  const DOMAIN = /^(?!-)[a-z0-9-]{1,63}(?<!-)(\.(?!-)[a-z0-9-]{1,63}(?<!-))+$/
  const CONTACT = /^(https:\/\/|mailto:)/
  const REGIONS = new Set([
    'af-south', 'ap-east', 'ap-south', 'ap-southeast', 'eu-central', 'eu-north',
    'eu-west', 'me-central', 'na-central', 'na-east', 'na-west', 'oc-southeast', 'sa-east',
  ])
  const SIZE_BANDS = new Set(['<100', '100-1k', '1k-10k', '10k+'])
  const CAPACITY_BANDS = new Set(['<100m', '100m', '1g', '10g'])

  const MODE_COPY: Record<Mode, { inputLabel: string; placeholder: string; consent: string; issueTemplate: string }> = {
    server: {
      inputLabel: 'Server domain',
      placeholder: 'chat.example.org',
      consent:
        'Also suggest this server automatically to people picking their first server. Optional — your listing stays either way. Your server has to allow it too.',
      issueTemplate: 'list-server.yml',
    },
    sfu: {
      inputLabel: 'Relay HTTPS origin',
      placeholder: 'https://sfu.example.com',
      consent:
        "Also let guilds in automatic mode route calls through this relay. Optional — your listing stays either way.",
      issueTemplate: 'list-sfu.yml',
    },
  }

  const root = document.querySelector<HTMLElement>('[data-wizard]')
  if (root) init(root)

  function init(root: HTMLElement) {
    root.setAttribute('data-enhanced', '')

    const checkInput = root.querySelector<HTMLInputElement>('[data-check-input]')!
    const checkButton = root.querySelector<HTMLButtonElement>('[data-check-button]')!
    const checkLabel = root.querySelector<HTMLElement>('[data-check-label]')!
    const gates = root.querySelector<HTMLElement>('[data-gates]')!
    const continueButton = root.querySelector<HTMLButtonElement>('[data-continue]')!

    const nameInput = root.querySelector<HTMLInputElement>('[data-field-name]')!
    const descriptionInput = root.querySelector<HTMLTextAreaElement>('[data-field-description]')!
    const descCount = root.querySelector<HTMLElement>('[data-desc-count]')!
    const operatorInput = root.querySelector<HTMLInputElement>('[data-field-operator]')!
    const regionLabelInput = root.querySelector<HTMLInputElement>('[data-field-region-label]')!
    const regionCodeInput = root.querySelector<HTMLSelectElement>('[data-field-region-code]')!
    const sizeInput = root.querySelector<HTMLSelectElement>('[data-field-size]')!
    const capacityInput = root.querySelector<HTMLSelectElement>('[data-field-capacity]')!
    const contactInput = root.querySelector<HTMLInputElement>('[data-field-contact]')!
    const consentInput = root.querySelector<HTMLInputElement>('[data-field-consent]')!
    const consentLabel = root.querySelector<HTMLElement>('[data-consent-label]')!

    const preview = root.querySelector<HTMLElement>('[data-preview]')!
    const previewName = root.querySelector<HTMLElement>('[data-preview-name]')!
    const previewBadge = root.querySelector<HTMLElement>('[data-preview-badge]')!
    const previewDomain = root.querySelector<HTMLElement>('[data-preview-domain]')!
    const previewRegion = root.querySelector<HTMLElement>('[data-preview-region]')!
    const previewBand = root.querySelector<HTMLElement>('[data-preview-band]')!
    const previewDescription = root.querySelector<HTMLElement>('[data-preview-description]')!
    const previewOperator = root.querySelector<HTMLElement>('[data-preview-operator]')!
    const previewVersion = root.querySelector<HTMLElement>('[data-preview-version]')!

    const preflight = root.querySelector<HTMLElement>('[data-preflight]')!
    const githubButton = root.querySelector<HTMLAnchorElement>('[data-github-button]')!
    const copyButton = root.querySelector<HTMLButtonElement>('[data-copy-button]')!
    const jsonCode = root.querySelector<HTMLElement>('[data-json]')!

    let mode: Mode = 'server'
    let check: {
      identity: string
      wellknown: any | null
      capabilities: any | null
      discovery: FetchResult
      capabilitiesResult: FetchResult | null
      health: FetchResult | null
    } | null = null
    // Invalidate asynchronous probe responses whenever identity or mode changes.
    let probeGeneration = 0

    for (const button of root.querySelectorAll<HTMLButtonElement>('[data-mode-switch]')) {
      button.addEventListener('click', () => setMode(button.dataset.modeSwitch as Mode))
    }

    function setMode(next: Mode) {
      probeGeneration++
      mode = next
      check = null
      checkInput.value = ''
      consentInput.checked = false
      root.querySelector<HTMLElement>('[data-stage-details]')!.hidden = true
      root.querySelector<HTMLElement>('[data-stage-submit]')!.hidden = true
      for (const button of root.querySelectorAll<HTMLButtonElement>('[data-mode-switch]')) {
        button.setAttribute('aria-pressed', String(button.dataset.modeSwitch === mode))
      }
      checkLabel.textContent = MODE_COPY[mode].inputLabel
      checkInput.placeholder = MODE_COPY[mode].placeholder
      consentLabel.textContent = MODE_COPY[mode].consent
      const isServer = mode === 'server'
      root.querySelector<HTMLElement>('[data-band-server]')!.hidden = !isServer
      root.querySelector<HTMLElement>('[data-band-sfu]')!.hidden = isServer
      renderGates([])
      continueButton.disabled = true
      checkInput.disabled = false
      checkButton.disabled = false
      checkButton.textContent = 'Check'
      update() // the other mode's band, consent and identity change the entry
    }

    // --- step 1: the probe ----------------------------------------------------

    checkButton.addEventListener('click', () => void runCheck())
    checkInput.addEventListener('input', () => {
      probeGeneration++
      check = null
      continueButton.disabled = true
      checkButton.disabled = false
      checkButton.textContent = 'Check'
      root.querySelector<HTMLElement>('[data-stage-details]')!.hidden = true
      root.querySelector<HTMLElement>('[data-stage-submit]')!.hidden = true
      renderGates([])
      update()
    })

    // Four outcomes, kept distinct because they mean different things: a
    // document that is not Telium is not a CORS problem, and a CORS wall is
    // not a dead server. The gate list words each honestly.
    type FetchResult =
      | { kind: 'ok'; body: any }
      | { kind: 'http'; status: number }
      | { kind: 'unreadable' }
      | { kind: 'dead' }

    async function fetchJson(url: string): Promise<FetchResult> {
      const controller = new AbortController()
      const timer = setTimeout(() => controller.abort(), TIMEOUT_MS)
      try {
        const response = await fetch(url, {
          signal: controller.signal,
          cache: 'no-store',
          headers: { accept: 'application/json' },
        })
        if (!response.ok) return { kind: 'http', status: response.status }
        try {
          return { kind: 'ok', body: await response.json() }
        } catch {
          // It answered, just not with JSON — some other site lives there.
          return { kind: 'http', status: response.status }
        }
      } catch {
        // The browser never got a readable answer. A no-cors retry tells an
        // answering server behind a CORS wall from no listener at all.
        try {
          await fetch(url, { mode: 'no-cors', signal: controller.signal, cache: 'no-store' })
          return { kind: 'unreadable' }
        } catch {
          return { kind: 'dead' }
        }
      } finally {
        clearTimeout(timer)
      }
    }

    // Mirrors scripts/probe.mjs: `api` may be a bare host, host:port or full origin.
    const toOrigin = (api: string | null | undefined, domain: string): string => {
      const value = (api ?? '').trim()
      if (!value) return `https://${domain}`
      if (/^https?:\/\//i.test(value)) return value.replace(/\/+$/, '')
      return `https://${value.replace(/\/+$/, '')}`
    }

    async function runCheck() {
      const generation = ++probeGeneration
      const checkedMode = mode
      const raw = checkInput.value.trim().toLowerCase()
      if (mode === 'server') {
        if (!DOMAIN.test(raw)) return gateFailure('Enter the domain as a bare lowercase hostname — like chat.example.org, no scheme or path.')
        check = { identity: raw, wellknown: null, capabilities: null, discovery: { kind: 'dead' }, capabilitiesResult: null, health: null }
      } else {
        const url = normalizeSfuUrl(raw)
        if (!url) return gateFailure('Enter the relay as a bare HTTPS origin — like https://sfu.example.com, no path or credentials.')
        check = { identity: url, wellknown: null, capabilities: null, discovery: { kind: 'dead' }, capabilitiesResult: null, health: { kind: 'dead' } }
      }

      checkButton.disabled = true
      checkButton.textContent = 'Checking…'
      continueButton.disabled = true
      renderGates([])

      const identity = check!.identity
      if (checkedMode === 'server') {
        const discovery = await fetchJson(`https://${identity}/.well-known/telium/server`)
        if (generation !== probeGeneration) return
        const wellknown = discovery.kind === 'ok' ? discovery.body : null
        const api = wellknown ? toOrigin(wellknown.api, identity) : null
        const capabilities = api ? await fetchJson(`${api}/_telium/v1/capabilities`) : null
        if (generation !== probeGeneration) return
        check = {
          identity,
          wellknown,
          capabilities: capabilities !== null && capabilities.kind === 'ok' ? capabilities.body : null,
          discovery,
          capabilitiesResult: capabilities,
          health: null,
        }
      } else {
        const health = await fetchJson(`${identity}/health`)
        if (generation !== probeGeneration) return
        check = {
          identity,
          wellknown: health.kind === 'ok' ? health.body : null,
          capabilities: null,
          discovery: health,
          capabilitiesResult: null,
          health: health,
        }
      }

      if (generation !== probeGeneration || checkedMode !== mode || checkInput.value.trim().toLowerCase() !== raw) return
      renderGates(computeGates())
      checkButton.disabled = false
      checkButton.textContent = 'Check again'
      continueButton.disabled = false
      update()
    }

    function normalizeSfuUrl(raw: string): string | null {
      try {
        const url = new URL(raw)
        if (url.protocol !== 'https:') return null
        if (/[\u0000-\u001f\u007f]/.test(raw)) return null
        if (url.username || url.password) return null
        if (url.pathname !== '/' && url.pathname !== '') return null
        if (url.search || url.hash) return null
        if (!url.hostname.includes('.')) return null
        return url.origin
      } catch {
        return null
      }
    }

    type Gate = { state: 'pass' | 'warn' | 'fail'; text: string }

    // Words a fetch result in the gate list.
    const answerGate = (result: FetchResult, labels: { pass: string; http: string; unreadable: string; dead: string }): Gate => {
      switch (result.kind) {
        case 'ok': return { state: 'pass', text: labels.pass }
        case 'http': return { state: 'fail', text: labels.http.replace('{status}', String(result.status)) }
        case 'unreadable': return { state: 'warn', text: labels.unreadable }
        default: return { state: 'fail', text: labels.dead }
      }
    }

    function computeGates(): Gate[] {
      const g: Gate[] = []
      if (!check) return g
      if (mode === 'server') {
        const wk = check.wellknown
        g.push(wk
          ? { state: 'pass', text: 'Server found' }
          : answerGate(check.discovery, {
              pass: 'Server found',
              http: `Not a Telium server (HTTP {status})`,
              unreadable: "This doesn't look like a Telium server",
              dead: 'No response',
            }))
        if (wk) {
          g.push(wk.server_name === check.identity
            ? { state: 'pass', text: 'Server name matches the domain' }
            : { state: 'warn', text: `Server name is "${wk.server_name ?? 'set'}", not this domain` })
          const caps = check.capabilities
          g.push(caps
            ? { state: 'pass', text: 'Capabilities read' }
            : { state: 'warn', text: check.capabilitiesResult?.kind === 'http'
                ? 'The API answered with something else'
                : check.capabilitiesResult?.kind === 'dead'
                  ? 'API did not respond — CI will check'
                  : "Couldn't read the API response — CI will check" })
          if (caps) {
            g.push(caps.registration_open === true
              ? { state: 'pass', text: 'Registration is open' }
              : { state: 'fail', text: 'Registration is closed' })
            g.push(caps.protocol_version === 'v1' || wk.protocol_version === 'v1'
              ? { state: 'pass', text: 'Protocol v1' }
              : { state: 'warn', text: `Protocol ${caps.protocol_version ?? wk.protocol_version ?? 'unknown'}` })
          }
          g.push(!wk.moved_to && !wk.sunset
            ? { state: 'pass', text: 'Not moving or shutting down' }
            : { state: 'warn', text: wk.moved_to ? `Moving to ${wk.moved_to}` : `Shutting down on ${wk.sunset}` })
        }
      } else {
        const health = check.wellknown
        g.push(health
          ? { state: 'pass', text: 'Relay found' }
          : answerGate(check.health!, {
              pass: 'Relay found',
              http: `Not a Telium relay (HTTP {status})`,
              unreadable: "This doesn't look like a Telium relay",
              dead: 'No response',
            }))
        if (health) {
          g.push(health.service === 'telium-sfu'
            ? { state: 'pass', text: 'This is a telium-sfu' }
            : { state: 'fail', text: 'Not a telium-sfu' })
          g.push(health.ok === true
            ? { state: 'pass', text: 'Relay is healthy' }
            : { state: 'fail', text: 'Relay reports a problem' })
          g.push(typeof health.accepting === 'boolean'
            ? health.accepting
              ? { state: 'pass', text: 'Taking new calls' }
              : { state: 'warn', text: 'Not taking new calls right now' }
            : { state: 'warn', text: "Doesn't report whether it takes calls" })
        }
      }
      return g
    }

    function renderGates(list: Gate[]) {
      gates.replaceChildren(...list.map((gate) => {
        const li = document.createElement('li')
        li.dataset.state = gate.state
        li.textContent = gate.text
        return li
      }))
    }

    function gateFailure(message: string) {
      renderGates([{ state: 'fail', text: message }])
    }

    // --- step 2: the declared half --------------------------------------------

    for (const input of [nameInput, descriptionInput, operatorInput, regionLabelInput, regionCodeInput, sizeInput, capacityInput, contactInput, consentInput]) {
      input.addEventListener('input', update)
    }

    function entry(): Record<string, unknown> | null {
      if (!check) return null
      const entry: Record<string, unknown> = mode === 'server'
        ? { domain: check.identity }
        : { url: check.identity }
      const name = nameInput.value.trim()
      const description = descriptionInput.value.trim()
      const regionLabel = regionLabelInput.value.trim()
      const regionCode = regionCodeInput.value
      const size = sizeInput.value
      const capacity = capacityInput.value
      const operator = operatorInput.value.trim()
      const contact = contactInput.value.trim()

      if (name) entry.name = name
      if (description) entry.description = description
      if (regionLabel || regionCode) entry.region = { label: regionLabel, code: regionCode }
      if (mode === 'server' && size) entry.size_band = size
      if (mode === 'sfu' && capacity) entry.capacity_band = capacity
      if (operator || contact) entry.operator = { name: operator, contact }
      if (consentInput.checked) {
        if (mode === 'server') entry.recommendations = { opt_in: true }
        else entry.feed = { opt_in: true }
      }
      return entry
    }

    // Truthy strings only; everything else renders as the em dash.
    const str = (value: unknown): string => (typeof value === 'string' ? value : '')

    function problems(entry: Record<string, unknown> | null): string[] {
      if (!entry) return []
      const p: string[] = []
      const checkLength = (value: unknown, field: string, min: number, max: number) => {
        const trimmed = str(value).trim()
        if (trimmed.length < min) p.push(`${field} needs at least ${min} character${min === 1 ? '' : 's'}`)
        if (trimmed.length > max) p.push(`${field} allows at most ${max} characters`)
      }
      checkLength(entry.name, 'Name', 2, 40)
      checkLength(entry.description, 'The one sentence', 10, 160)
      const region = entry.region as { label?: unknown; code?: unknown } | undefined
      if (region) {
        checkLength(region.label, 'The place name', 2, 40)
        if (!REGIONS.has(str(region.code))) p.push('Pick the nearest region code')
      } else {
        p.push('Say where the hardware is, and pick the nearest region code')
      }
      if (mode === 'server' && !SIZE_BANDS.has(str(entry.size_band))) p.push('Pick an account range')
      if (mode === 'sfu' && !CAPACITY_BANDS.has(str(entry.capacity_band))) p.push('Pick an uplink band')
      const operator = entry.operator as { name?: unknown; contact?: unknown } | undefined
      if (operator) {
        checkLength(operator.name, 'Operator', 2, 60)
        if (!CONTACT.test(str(operator.contact))) p.push('The contact must start with https:// or mailto:')
      } else {
        p.push('Add an operator name and a contact that reaches a person')
      }
      return p
    }

    const jsonPretty = (entry: Record<string, unknown>): string => JSON.stringify(entry, null, 2)

    const issueBody = (json: string): string => `\`\`\`json\n${json}\n\`\`\``

    function update() {
      const current = entry()
      const list = problems(current)
      const items: HTMLLIElement[] = current === null
        ? []
        : list.length
          ? list.map((text) => {
              const li = document.createElement('li')
              li.textContent = text
              li.dataset.state = 'warn'
              return li
            })
          : [(() => {
              const li = document.createElement('li')
              li.textContent = 'Everything the validators check passes — the request is ready to file.'
              li.dataset.state = 'pass'
              return li
            })()]
      preflight.replaceChildren(...items)

      if (!current) {
        githubButton.href = '#'
        githubButton.setAttribute('aria-disabled', 'true')
        copyButton.disabled = true
        jsonCode.textContent = ''
      }
      if (current) {
        const json = jsonPretty(current)
        jsonCode.textContent = issueBody(json)
        const url = new URL(`https://github.com/telium-chat/telium/issues/new`)
        url.searchParams.set('template', MODE_COPY[mode].issueTemplate)
        url.searchParams.set('title', `List ${check!.identity}`)
        url.searchParams.set('entry-json', issueBody(json))
        githubButton.href = url.href
        githubButton.setAttribute('aria-disabled', list.length ? 'true' : 'false')
        copyButton.disabled = false
      }

      // Preview: the declared half as the row will read it, with the probed
      // half (badges, version) from the check that just ran.
      preview.hidden = current === null
      if (current) {
        previewName.textContent = str(current.name) || '—'
        previewDomain.textContent = check!.identity
        previewRegion.textContent = str((current.region as any)?.label) || '—'
        previewBand.textContent = mode === 'server'
          ? (str(current.size_band) || '—')
          : (str(current.capacity_band) || '—')
        previewDescription.textContent = str(current.description)
        previewOperator.textContent = str((current.operator as any)?.name) || '—'
        previewVersion.textContent = str((mode === 'server' ? check!.capabilities?.server_version : undefined)) || '—'
        const badge = previewBadgeOf()
        previewBadge.hidden = !badge
        if (badge) {
          previewBadge.dataset.badge = badge.kind
          previewBadge.textContent = badge.label
        }
      }
    }

    function previewBadgeOf(): { kind: string; label: string } | null {
      if (!check) return null
      if (mode === 'server') {
        if (check.wellknown?.moved_to) return { kind: 'down', label: 'Moved' }
        if (check.wellknown?.sunset) return { kind: 'down', label: 'Sunsetting' }
        if (!check.wellknown) return { kind: 'down', label: 'Unreachable' }
        if (check.capabilities?.registration_open === true) return { kind: 'open', label: 'Open' }
        if (check.capabilities) return { kind: 'closed', label: 'Closed' }
        return null
      }
      if (!check.wellknown) return { kind: 'down', label: 'Offline' }
      if (check.wellknown.ok !== true) return { kind: 'down', label: 'Offline' }
      if (check.wellknown.accepting === false) return { kind: 'full', label: 'Full' }
      return { kind: 'healthy', label: 'Healthy' }
    }

    // --- step 3: file it --------------------------------------------------------

    continueButton.addEventListener('click', () => {
      root.querySelector<HTMLElement>('[data-stage-details]')!.hidden = false
      root.querySelector<HTMLElement>('[data-stage-submit]')!.hidden = false
      update()
      root.querySelector<HTMLElement>('[data-stage-details]')!.scrollIntoView({ behavior: 'smooth', block: 'start' })
    })

    // An aria-disabled link is only announced as disabled; it is still clickable.
    githubButton.addEventListener('click', (event) => {
      if (githubButton.getAttribute('aria-disabled') === 'true') event.preventDefault()
    })

    copyButton.addEventListener('click', async () => {
      if (!jsonCode.textContent) return
      try {
        await navigator.clipboard.writeText(jsonCode.textContent)
        copyButton.textContent = 'Copied'
        setTimeout(() => {
          copyButton.textContent = 'Copy the entry'
        }, 1600)
      } catch {
        // Selection is the fallback a clipboard permission denial leaves.
        const range = document.createRange()
        range.selectNodeContents(jsonCode)
        const selection = window.getSelection()
        selection?.removeAllRanges()
        selection?.addRange(range)
      }
    })

    // --- boot --------------------------------------------------------------------

    descriptionInput.addEventListener('input', () => {
      descCount.textContent = String(descriptionInput.value.length)
    })

    // ?type=relay deep-links straight into the relay mode, which is what the
    // "List it here" links on /sfus point at.
    const params = new URLSearchParams(window.location.search)
    if (params.get('type') === 'relay' || params.get('type') === 'sfu') {
      setMode('sfu')
    } else {
      setMode('server')
    }
  }
</script>
