{
  "name": "telium-site",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.4",
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:portal": "bun install --cwd ../web --frozen-lockfile && bun run --cwd ../web build && astro build && node scripts/build-portal.mjs",
    "build:production": "npm run recommendations:write && npm run build:portal",
    "preview:portal": "node scripts/preview-portal.mjs",
    "preview": "astro preview",
    "validate": "node scripts/validate-registry.mjs",
    "validate:sfus": "node scripts/validate-sfus.mjs",
    "probe:sfus": "node scripts/probe-sfus.mjs",
    "sfu-directory:keygen": "node scripts/generate-sfu-directory-key.mjs",
    "sfu-directory:write": "node scripts/sfu-directory.mjs --write",
    "sfu-directory:check": "node scripts/sfu-directory.mjs",
    "test:sfu-directory": "node --test scripts/sfu-directory.test.mjs scripts/probe-sfus.test.mjs",
    "probe": "node scripts/probe.mjs",
    "recommendations:keygen": "node scripts/generate-recommendation-key.mjs",
    "recommendations:check": "node scripts/recommendations.mjs --check",
    "recommendations:write": "node scripts/recommendations.mjs --write",
    "test:recommendations": "node --test scripts/recommendations.test.mjs",
    "test:registry-issue": "node --test scripts/registry-issue.test.mjs",
    "test:portal-routes": "node --test scripts/portal-routes.test.mjs",
    "check": "node scripts/check-no-third-party.mjs",
    "capture": "node scripts/capture/run.mjs",
    "og": "node scripts/og.mjs"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.2",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "lucide-static": "^0.469.0",
    "playwright": "^1.64.1",
    "sharp": "^0.35.5"
  }
}
