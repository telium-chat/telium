# Telium settings. Save this file as .env beside compose.yml, fill in the two
# required lines, then: docker compose up -d
#
# Everything else is optional. A line left commented out takes the suggestion
# described above it. After changing anything, run `docker compose up -d`.
# Keep settings in this file, not only in your shell: the updater re-reads it.
# Comments go on their own lines; text after a value becomes part of it.

# ---------------------------------------------------------------- required

# The hostname clients connect to, through your reverse proxy.
TELIUM_DOMAIN=chat.example.com

# Who may sign up: closed (only people with a registration code) or open.
TELIUM_REGISTRATION=closed

# ---------------------------------------------------------- account domain

# For addresses like @you:example.com while the server lives at
# chat.example.com. Set it BEFORE the first account; never change it after.
#TELIUM_SERVER_NAME=example.com

# --------------------------------------------------------- uploads, storage
#
# Suggestions that depend on registration or on the disk are worked out on
# the first start and then kept; set a line here to change one later.

# quota, enabled or disabled.
#TELIUM_MEDIA_POLICY=quota
# Upload allowance per account.
#TELIUM_MEDIA_QUOTA=1GiB
# Largest single file.
#TELIUM_MEDIA_FILE_MAX=50MiB
# All uploads together. Suggestion: three quarters of the disk. 0 = no limit.
#TELIUM_MEDIA_TOTAL=100GiB
# Free space uploads must leave. Suggestion: a tenth of the disk.
#TELIUM_MEDIA_FREE_RESERVE=10GiB
# Delete attachments after this many days, 0 = never.
# Suggestion: 30 for open registration, 0 for closed.
#TELIUM_MEDIA_RETENTION_DAYS=0

# ------------------------------------------------------------------ backups

# Include attachments in backups: yes or no.
# Suggestion: no for open registration, yes for closed.
#TELIUM_BACKUP_MEDIA=yes
# How often: 6h, 12h, 1d.
#TELIUM_BACKUP_INTERVAL=6h
# How many to keep.
#TELIUM_BACKUP_KEEP=2
# Skip a backup that would leave less free space. Suggestion: a tenth of the disk.
#TELIUM_BACKUP_FREE_RESERVE=10GiB

# ------------------------------------------------------------------ updates

# automatic, or manual to stop all updates.
#TELIUM_UPDATES=automatic
# Hold the server at an exact image, and say why (both lines together).
#TELIUM_PIN=ghcr.io/telium-chat/telium:server-v0.5.1
#TELIUM_PIN_REASON=waiting for the release notes on 0.5.2
# Restart only inside this window, HH:MM-HH:MM in UTC.
#TELIUM_UPDATE_WINDOW=03:00-05:00
# Warning shown to connected users before a restart, in seconds.
#TELIUM_RESTART_NOTICE_SECS=300

# ------------------------------------------------------------- network, host

# Host port on 127.0.0.1 that your reverse proxy connects to.
#TELIUM_PORT=8448
# Proxies whose X-Forwarded-For the server believes, as TOML strings.
# The default covers a proxy on the host and the bundled Caddy.
#TELIUM_TRUSTED_PROXIES='"172.31.241.1", "172.31.241.2"'
# Rootless Docker: the full path of your user's socket.
#DOCKER_SOCKET=/run/user/1000/docker.sock

# --------------------------------------------------------- optional profiles

# proxy: the bundled Caddy does HTTPS (only if nothing else uses 80/443).
# voice: your own SFU for group calls (also uncomment [voice] in compose.yml).
#COMPOSE_PROFILES=proxy
#ACME_EMAIL=you@example.com
#TELIUM_SFU_DOMAIN=sfu.chat.example.com
#TELIUM_LIVEKIT_DOMAIN=livekit.chat.example.com
