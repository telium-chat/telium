# The standalone kit's settings. Compose reads this file for every ${...} in
# compose.yml, the containers read it for the ${env:...} references in
# telium.toml, and Caddy reads it for the domains in the Caddyfile. One file,
# so one place answers "what is this deployment called".
#
# Edit the values, then: docker compose up -d
# The installer writes this file for you; it is committed with placeholders so
# that a manual install has something to start from.


# The identity of the server -- the half after the @ in user ids, baked into
# everything it ever signs. Changing it later is a migration, not an edit.
TELIUM_CHAT_DOMAIN=chat.example.com

# Where Let's Encrypt sends expiry mail for the kit's Caddy. Ignored when the
# Caddy service is not enabled.
ACME_EMAIL=you@example.com

# The two names the voice profile publishes. Only meaningful once COMPOSE_PROFILES
# below includes "voice", but the Caddyfile's SFU blocks and sfu.toml want them
# written in either way, so they live here from the start.
TELIUM_SFU_DOMAIN=sfu.example.com
TELIUM_LIVEKIT_DOMAIN=livekit.example.com

# Which optional services are on: "proxy" (the kit's Caddy), "voice" (the SFU),
# both, or empty for just the server. The installer sets this from your answers;
# edit it to switch later, then `docker compose up -d` again.
COMPOSE_PROFILES=proxy

# Pin the server or the SFU by replacing the tag here rather than editing
# compose.yml. Empty means follow the release channel.
TELIUM_IMAGE=
TELIUM_SFU_IMAGE=
